---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Not Found — CMNA" description="The requested CMNA page was not found.">
  <header class="page-head">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1 class="page-title">This approximation did not converge.</h1>
      <p class="lede">
        The requested page is not here. Try the method atlas, the book page, or the
        companion software.
      </p>
      <div class="hero-actions">
        <a class="button" href="/">Return home</a>
        <a class="button secondary" href="/methods/">Browse methods</a>
      </div>
    </div>
  </header>
</BaseLayout>
